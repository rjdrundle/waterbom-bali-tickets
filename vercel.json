{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "rewrites": [
    { "source": "/", "destination": "/Waterbom 2.0.dc.html" },
    { "source": "/tickets", "destination": "/Tickets.dc.html" },
    { "source": "/rides", "destination": "/Rides.dc.html" },
    { "source": "/gallery", "destination": "/Gallery.dc.html" },
    { "source": "/promo-codes", "destination": "/Promo Codes.dc.html" },
    { "source": "/packages", "destination": "/Packages.dc.html" },
    { "source": "/plan-your-visit", "destination": "/Plan Your Visit.dc.html" },
    { "source": "/about", "destination": "/About Waterbom Bali.dc.html" },
    { "source": "/reviews", "destination": "/Reviews.dc.html" },
    { "source": "/faq", "destination": "/FAQ.dc.html" },
    { "source": "/guides", "destination": "/Guides.dc.html" },
    { "source": "/contact", "destination": "/Contact.dc.html" },
    { "source": "/terms", "destination": "/Terms.dc.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://embedded-widget.azurewebsites.net https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://embedded-widget.azurewebsites.net; frame-src https://embedded-widget.azurewebsites.net; frame-ancestors 'none'; base-uri 'self'; object-src 'none'" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml" }]
    },
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain" }]
    },
    {
      "source": "/llms.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/favicon.svg",
      "headers": [{ "key": "Content-Type", "value": "image/svg+xml" }]
    },
    {
      "source": "/pricing.md",
      "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }]
    }
  ]
}
